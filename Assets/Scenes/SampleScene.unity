--- !u!114 &205893722
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 205893720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aaf0eb26821673d4d92aa85389dfd183, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueVR
  dialogueText: {fileID: 1749546488}
  phrases:
  - "\u041A\u043E\u0440\u043E\u0447\u0435, \u041C\u0435\u0447\u0435\u043D\u044B\u0439,
    \u044F \u0442\u0435\u0431\u044F \u0441\u043F\u0430\u0441..."
  - "...\u0438 \u0432 \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u0441\u0442\u0432\u043E
    \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0435 \u0431\u0443\u0434\u0443."
  - "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0448\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F
    \u043F\u0430\u0440\u0443 \u0437\u0430\u0434\u0430\u043D\u0438\u0439 \u2014 \u0438
    \u043C\u044B \u0432 \u0440\u0430\u0441\u0447\u0435\u0442\u0435."
  - "\u0412\u0432\u0438\u0434\u0443 \u043D\u043E\u0432\u043E\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u043E\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043D\u0430\u0448\u0435\u0439 \u0441\u0442\u0440\u0430\u043D\u044B..."
  - "...\u0418 \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u043D\u0435 \u043F\u0440\u0438\u0441\u0435\u043B\u0438
    \u043D\u0443\u0436\u043D\u043E \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u0432\u0441\u0435\u0445 \u0434\u0435\u043D\u044F\u043A"
  - "...\u0438\u043D\u0430\u0447\u0435 \u043F\u0440\u0438\u0434\u0443\u0442 \u0434\u044F\u0434\u0438
    \u0438 \u0431\u0443\u0434\u0435\u0442 \u043F\u043B\u043E\u0445\u0430\n\u041C\u043E\u043D\u0435\u0442\u044B:
    {coins}"
  - "\u0412 \u0445\u0430\u0442\u0435 \u0447\u0435\u0442 \u043F\u044B\u043B\u044C\u043D\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E... "
  - "...\u0443\u0431\u0435\u0440\u0438 \u043F\u0430\u0443\u0442\u0438\u043D\u043A\u0443
    \u043F\u043E \u0431\u0440\u0430\u0442\u0441\u043A\u0438\r\n\u041F\u0430\u0432\u0443\u0442\u0438\u043D\u043A\u0430:
    {cubes}"
  nextButton: {fileID: 1065033241}
